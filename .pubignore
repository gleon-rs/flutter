# Used by `dart pub publish` instead of .gitignore (keep in sync with it).
# Unlike .gitignore, native/ is NOT ignored: `bin/prepare_publish.dart` puts the
# libraries of the release there, so they ship inside the pub.dev archive and
# pub.dev users never download from GitHub. Publish only from its copy.

.dart_tool/
.packages
build/
pubspec.lock
doc/api/
.env*
*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map
.flutter-plugins
.flutter-plugins-dependencies
test/**/failures/
example/test/failures/
coverage/
.antigravity/
CLAUDE.local.md
.DS_Store
.fvm/

# Maintainer-only (the tests import bin/, which is not shipped either)
/benchmark/
/bin/
/test/
/example/benchmark/
/dist/
/.github/
/native/gleon_ref
# Stamps of local builds: the archive's libraries are accepted without a pin.
/native/*/gleon_ref

# The example names its fallback platform there (a dot-directory pub would skip).
!/example/.gleon/
!/example/.gleon/gleon.yaml
